# ---------------------------------------------------------------------------
# Wealthy Office Cabin Booking — environment variables
# Copy to .env for local development. NEVER commit real values.
# On Render, set these under the service's "Environment" tab.
# ---------------------------------------------------------------------------

# Supabase project (Dashboard › Project Settings › API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Public "anon" key — every query made with it is subject to Row Level Security.
SUPABASE_ANON_KEY=replace-with-anon-key
# Service-role key — bypasses RLS. Used ONLY by the server-side e-mail worker.
# Leave empty to disable e-mail sending from the web app.
SUPABASE_SERVICE_ROLE_KEY=

# Company e-mail domain(s) allowed to sign in (comma-separated, no "@").
# Must match office_settings.allowed_email_domains in the database.
ALLOWED_EMAIL_DOMAIN=wealthy.in

# Branding fallbacks (admins can change these in Administration › Settings)
APP_NAME=Wealthy Office Cabin Booking
COMPANY_NAME=Wealthy
COMPANY_LOGO_URL=

# Used for e-mail links / redirects; your public URL, e.g. https://cabins.wealthy.in
APP_BASE_URL=http://localhost:8501
OFFICE_TIMEZONE=Asia/Kolkata
SESSION_IDLE_MINUTES=60
APP_ENV=development
LOG_LEVEL=INFO

# Booking notification e-mails (any SMTP provider: Google Workspace relay,
# Microsoft 365, Amazon SES, SendGrid, Postmark, …)
NOTIFICATIONS_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=cabins@wealthy.in
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15

# Only needed to run database migrations (scripts/apply_migrations.py).
# Supabase › Project Settings › Database › Connection string (Session pooler).
DATABASE_URL=

# Only needed to run the database test suite locally / in CI.
TEST_DATABASE_URL=
